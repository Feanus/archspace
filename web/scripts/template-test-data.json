  "templates": {
    "issue": {
      "path": ".github/ISSUE_TEMPLATE/architecture-proposal.yml",
      "url": "https://github.com/scv11/template-test/blob/main/.github/ISSUE_TEMPLATE/architecture-proposal.yml",
      "content": "name: 🏗️ Architecture proposal\ndescription: Propose and validate one change to the LLM architecture.\ntitle: \"[ARCH-PROP] \"\nlabels:\n  - under review\n\nbody:\n  - type: markdown\n    attributes:\n      value: |\n        # Architecture proposal\n\n        Use this form to propose one architecture change. Keep the proposal focused and submit unrelated changes separately.\n        \n  - type: input\n    id: proposal_name\n    attributes:\n      label: Architecture Name\n      description: Give the proposed base architecture or modification a short, descriptive name.\n      placeholder: \"Example: OLMo3\"\n    validations:\n      required: true\n\n  - type: input\n    id: base_architecture_issue\n    attributes:\n      label: Parent issue\n      description: For a modification, link the issue that tracks the base architecture. Leave blank for a root architecture.\n      placeholder: \"Example: #123\"\n    validations:\n      required: false\n\n  - type: textarea\n    id: problem_and_hypothesis\n    attributes:\n      label: Motivations\n      description: Describe the current limitation or opportunity, the measurable outcome you expect, and any supporting rationale, evidence, or related work that motivates this proposal.\n      placeholder: Explain the problem and the expected outcome.\n    validations:\n      required: true\n\n  - type: textarea\n    id: proposed_change\n    attributes:\n      label: Proposed Architecture\n      description: Describe what changes from the base architecture, what remains unchanged, and the expected impact on parameters, compute, memory, or latency if known.\n      placeholder: Explain the proposed architecture change.\n    validations:\n      required: true\n\n  - type: textarea\n    id: existing_results\n    attributes:\n      label: Existing Results\n      description: Summarize any existing results, experiments, prototypes, or observations that support this proposal.\n      placeholder: Provide any existing results, preliminary experiments, prototypes, or evidence supporting this proposal.\n    validations:\n      required: true\n\n  - type: textarea\n    id: validation_plan\n    attributes:\n      label: Experiments Plan\n      description: Identify the baseline, evaluation method and metrics, measurable success criteria, and any notable compute or data requirements.\n      placeholder: Explain how the proposal will be evaluated.\n    validations:\n      required: true\n\n  - type: markdown\n    attributes:\n      value: |\n        ---\n\n        Maintainers review the proposal before implementation starts:\n\n        - `under review`: waiting for a maintainer decision\n        - `in-progress`: approved for implementation\n        - `declined`: rejected or deferred; the Issue is closed\n        - `done`: a linked implementation PR was merged; the Issue is closed\n\n        Status labels are mutually exclusive and maintained by repository automation.\n"
    },
    "pullRequest": {
      "path": ".github/pull_request_template.md",
      "url": "https://github.com/scv11/template-test/blob/main/.github/pull_request_template.md",
      "content": "---\nTitle: \nArchitecture Name: \nAbout: \n\n---\n\n<!-- Link to the corresponding Architecture Proposal issue -->\n<!-- Example: #123 -->\n> **Architecture Proposal (issue #)**: \n\n## Implementation Details:\n<!-- Describe the implemented architecture modification.\nInclude:\n- Modified components\n- Key implementation details\n- Compatibility considerations\n- Any deviations from the original proposal\n-->\n\n## Experimental Validation:\n\n#### Research Question 1\n\n<!-- What hypothesis does this experiment aim to validate? -->\n*Hypothesis:* \n\n<!-- Analyze experimental results.\nExplain observations, comparisons, and potential reasons.\n-->\n*Results & Analysis:* \n\n<!-- Summarize the findings for this research question -->\n*Findings:* \n\n<!-- Add more research questions if needed -->\n\n\n## Archive:\n\n<!-- Example: https://wandb.ai/.../reports/... -->\n- WandB Report (include training and evaluation logs): \n\n<!-- Example: https://huggingface.co/collections/... -->\n- HuggingFace Collection (include model checkpoints): \n\n---\n\n## Reviewer Assessment (for repo reviewers):\n<!-- Repository reviewers provide an overall assessment of the implementation and experimental validation.\nExamples:\n- The implementation is correct and the experimental results support the proposed architecture.\n- Additional experiments are recommended.\n-->\n\n**Merge Checklist**:\n\n- [ ] The implementation PR is linked to an `in-progress` Architecture Proposal issue (#).\n- [ ] The implementation correctness of the proposed architecture is verified.\n- [ ] The effectiveness of the proposed architecture is validated at 1B, 3B, and 8B model scales.\n- [ ] The archive information is complete, including WandB reports and HuggingFace collections of model checkpoints.\n"
    }
  },
